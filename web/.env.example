# Copy to `.env.local` (git-ignored). Every value here is PUBLIC: Next inlines
# NEXT_PUBLIC_* into the static bundle. Never put private keys or secrets here.

# Leave unset for the offline reference dashboard (static reference prices).
# localnet | devnet | mainnet
NEXT_PUBLIC_CLUSTER=

# Optional overrides (defaults per cluster):
#   localnet http://127.0.0.1:8899, devnet https://api.devnet.solana.com
NEXT_PUBLIC_RPC_URL=

# Signed-quote API: the oracle pusher. On test clusters, `web/dev/oracle.ts`
# (http://127.0.0.1:8787 by default; run a second one with LVRT_ORACLE_PORT for devnet).
NEXT_PUBLIC_QUOTE_API=

# Public origin for canonical URLs / share cards.
NEXT_PUBLIC_SITE_URL=
